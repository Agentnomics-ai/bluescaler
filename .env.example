# Lead notification emails (demo requests + contact form)
# Copy to .env.local for local development, and set the same values as
# Environment Variables in the Vercel project for production.

# --- Email provider: set ONE of these ---------------------------------
# Resend is tried first, SendGrid second.
RESEND_API_KEY=
# SENDGRID_API_KEY=

# --- Optional overrides ------------------------------------------------
# Where lead notifications are delivered. Defaults to javed@agentnomics.ai.
# LEAD_NOTIFICATION_EMAIL=javed@agentnomics.ai

# Sender address. Must be on a domain verified with the provider above,
# or delivery will fail. Defaults to "BlueScaler <noreply@bluescaler.com>".
# LEAD_EMAIL_FROM=BlueScaler <noreply@bluescaler.com>
